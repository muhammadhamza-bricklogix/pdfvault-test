NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
NEXT_PUBLIC_GOOGLE_API_KEY=YOUR_BROWSER_API_KEY_HERE
NEXT_PUBLIC_API_BASE_URL=http://localhost:7403

# Public PDF share links (`/share/[token]` + `/api/share/*`).
# - Used to HMAC-sign + verify share tokens server-side. Required.
# - Must be a long random string (32+ bytes). Generate with:
#     openssl rand -base64 48
# - Rotating this secret instantly invalidates every existing share link,
#   so coordinate with users before changing it in production.
SHARE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public base URL used when generating shareable links shown to users.
# Falls back to the request's host header if unset, but set this
# explicitly in production so links always point to your canonical host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
