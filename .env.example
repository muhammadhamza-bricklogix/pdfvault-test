# ─────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) environment variables
#
# Rules:
#   - NEXT_PUBLIC_* values are baked into the JS bundle at BUILD time
#     (pass via --build-arg in Docker). Changing them requires a rebuild.
#   - Server-only secrets (no NEXT_PUBLIC_ prefix) are read at runtime
#     and should be injected by ECS task-definition env or SSM/Secrets Mgr.
#   - Never commit the real .env file. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# Clerk — auth provider. Publishable key is safe to ship in JS; secret is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Backend API root. Localhost in dev, ALB / API-Gateway URL in prod.
# Every backend call goes through `lib/config/api-client.ts`, which prefixes
# this value automatically.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7403

# Public-facing canonical URL of THIS frontend. Used to build shareable
# `/share/[token]` links. Falls back to request Host header if unset, but
# set it explicitly in prod so links always point at your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Drive picker (cloud-import). All three values are public to the
# browser — they're scoped to your allowed origins in Google Cloud Console.
# PROJECT_NUMBER is the numeric prefix before the dash in CLIENT_ID
# (e.g. CLIENT_ID "123456789012-abcxyz.apps.googleusercontent.com" ->
# PROJECT_NUMBER "123456789012"). Required by the Picker under the
# drive.file scope so picked files are granted to this Cloud project.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=YOUR_BROWSER_API_KEY
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=YOUR_GOOGLE_PROJECT_NUMBER

# OneDrive / Microsoft Graph picker (cloud-import). `_TENANT_ID` defaults
# to "common" (any AAD tenant or personal account); set to your tenant
# GUID for single-tenant deployments.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=YOUR_AZURE_APP_ID
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common

# Weglot — powers the landing-page language switcher. Get the key from
# Weglot dashboard → Settings → API key (starts with `wg_`). Leave blank
# to hide the switcher entirely (WeglotLoader short-circuits when unset).
# When set, add every language you want offered on the frontend to the
# Weglot project's destination-languages list, or the switcher will log
# "isn't a language you have added" on click.
NEXT_PUBLIC_WEGLOT_API_KEY=

# Public PDF share links (`/share/[token]` + `/api/share/*`).
# Server-only. Used to HMAC-sign + verify share tokens. Required.
# Generate with: openssl rand -base64 48
# Rotating this invalidates EVERY existing share link.
SHARE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_BYTES

# Share-link storage backend. Defaults to `memory`.
#   memory : in-process Map (dev / single-instance)
#   redis  : Redis-backed bytes/metadata/password/deny-list
#   s3     : S3-backed bytes store (metadata/password/deny-list still Redis/memory)
# Missing env vars for the selected backend cause a graceful fallback to memory.
SHARE_STORE=memory

# Required when SHARE_STORE=redis. SHARE_REDIS_URL takes precedence over REDIS_URL.
# SHARE_REDIS_URL=redis://localhost:6379

# Required when SHARE_STORE=s3. Credentials are optional if the runtime has an
# IAM role / instance profile with S3 access.
# SHARE_S3_REGION=us-east-1
# SHARE_S3_BUCKET=pdfedits-shares
# SHARE_S3_ENDPOINT=                    # optional, for MinIO / R2
# SHARE_S3_ACCESS_KEY_ID=
# SHARE_S3_SECRET_ACCESS_KEY=
